{
  "name": "@episteme/app-learn",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal Learn interaction surface: ask, see why prior understanding surfaced, record what you now understand.",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "default": "./dist/seed.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "episteme-learn": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "learn": "tsc -b && node dist/cli.js",
    "serve": "tsc -b && node dist/serve.js"
  },
  "dependencies": {
    "@episteme/agent": "workspace:*",
    "@episteme/core": "workspace:*",
    "@episteme/domain-learn": "workspace:*",
    "@episteme/sdk": "workspace:*",
    "@episteme/storage-local": "workspace:*"
  }
}
